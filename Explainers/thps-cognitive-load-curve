                <!-- Curve Gradient -->
                <linearGradient id="curve-gradient" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#ef4444" />
                  <stop offset="25%" stop-color="#f59e0b" />
                  <stop offset="55%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#10b981" />
                </linearGradient>
