<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>THPS Skill Acquisition & Cognitive Capacity Simulator</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #070a12;
      color: #f1f5f9;
      overflow-x: hidden;
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    
    /* 16:9 Graph Ratio Container */
    .graph-aspect-box {
      width: 100%;
      aspect-ratio: 16 / 9;
      position: relative;
    }
    @media (max-width: 640px) {
      .graph-aspect-box {
        aspect-ratio: 16 / 10;
      }
    }

    /* Glassmorphic Panels */
    .glass-card {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    
    /* Tube Overload Pulse Animation */
    @keyframes pulse-red {
      0%, 100% { 
        box-shadow: 0 0 18px rgba(239, 68, 68, 0.6), inset 0 0 16px rgba(239, 68, 68, 0.5); 
        border-color: rgba(239, 68, 68, 0.9);
      }
      50% { 
        box-shadow: 0 0 35px rgba(239, 68, 68, 1), inset 0 0 28px rgba(239, 68, 68, 0.8); 
        border-color: #fca5a5;
      }
    }
    .tube-overload {
      animation: pulse-red 1s infinite ease-in-out;
    }

    /* Red Zone Total Meltdown Fill */
    .red-zone-fill {
      background: linear-gradient(180deg, #ef4444 0%, #b91c1c 60%, #7f1d1d 100%);
      box-shadow: 0 0 25px rgba(239, 68, 68, 0.8) inset;
    }

    /* SVG Draggable Node Styling */
    .draggable-pill {
      cursor: grab;
      touch-action: none;
      transition: filter 0.15s ease;
    }
    .draggable-pill:active, .draggable-pill.dragging {
      cursor: grabbing;
      filter: brightness(1.3) drop-shadow(0 0 14px currentColor);
    }

    /* Smooth Height & Color Transitions */
    .tube-segment {
      transition: height 0.1s linear, background-color 0.2s ease;
    }

    /* Custom scrollbars */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #0b1120;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between p-3 sm:p-5 lg:p-7">

  <!-- Full-Width Header Section -->
  <header class="max-w-6xl w-full mx-auto mb-3 sm:mb-5 border-b border-slate-800/90 pb-3 sm:pb-4">
    <div class="flex items-center space-x-2.5">
      <span class="px-2.5 py-0.5 text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider bg-blue-500/20 text-blue-400 border border-blue-500/40 rounded-md">
        THPS Mechanics
      </span>
      <h1 class="text-lg sm:text-2xl font-black text-white tracking-tight">
        Cognitive Load vs. Skill Acquisition
      </h1>
    </div>
    <p class="text-xs sm:text-sm text-slate-400 mt-1.5 leading-relaxed max-w-4xl">
      Demonstrating the <strong class="text-slate-200">Juggler Model (Reverse S-Curve)</strong>: Skills stay at peak cognitive load (~110% &rarr; 99%) throughout Phase 1, plunge through Phase 2 as self-correction takes hold, and stabilize at ~3% to 8% in the Autonomous phase.
    </p>
  </header>

  <!-- Main Interactive Coordinate Stage & Tube -->
  <main class="max-w-6xl w-full mx-auto flex-1 flex flex-col items-center justify-center">

    <!-- Graph + Capacity Tube Wrapper -->
    <div class="w-full glass-card rounded-2xl p-3 sm:p-5 shadow-2xl relative">
      
      <div class="flex items-stretch gap-3 sm:gap-6">
        
        <!-- LEFT: Cognitive Capacity Tube -->
        <div class="w-20 sm:w-28 shrink-0 flex flex-col items-center">
          <div class="text-[10px] sm:text-xs font-bold text-slate-300 uppercase tracking-wider text-center leading-tight mb-2">
            Cognitive<br>Capacity
          </div>

          <!-- Glass Tube Housing -->
          <div class="relative w-full flex-1 bg-slate-950/90 rounded-2xl border-2 border-slate-700/80 p-0 overflow-hidden transition-all duration-300" id="tube-container">
            
            <!-- 100% MAX Threshold Line -->
            <div class="absolute w-full left-0 border-b-2 border-dashed border-red-500 z-20 pointer-events-none" style="bottom: 90.9%;">
              <span class="absolute right-1 -top-3.5 text-[8.5px] sm:text-[9.5px] font-extrabold text-red-400 mono tracking-wider bg-slate-900/90 px-1 rounded">100% MAX</span>
            </div>

            <!-- 50% Threshold Line -->
