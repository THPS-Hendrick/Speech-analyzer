              <!-- Phase Shading Areas -->
              <rect x="110" y="25" width="280" height="475" fill="url(#grad-cognitive)" />
              <rect x="670" y="25" width="290" height="475" fill="url(#grad-autonomous)" />

              <!-- Phase Vertical Dividing Markers -->
              <line x1="390" y1="25" x2="390" y2="500" stroke="#334155" stroke-dasharray="6 6" stroke-width="1.8"/>
              <line x1="670" y1="25" x2="670" y2="500" stroke="#334155" stroke-dasharray="6 6" stroke-width="1.8"/>

              <!-- Y-AXIS -->
              <line x1="110" y1="25" x2="110" y2="500" stroke="#64748b" stroke-width="2.5"/>
              <polygon points="110,14 105,27 115,27" fill="#64748b" />
              
              <!-- Y-Axis Title & Tick Markers -->
