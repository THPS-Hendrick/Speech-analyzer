    <!-- BOTTOM: Speaking Skills Bank & Controls -->
    <div class="w-full glass-card rounded-2xl p-4 sm:p-5 shadow-xl border border-slate-800">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3.5 border-b border-slate-800 pb-3">
