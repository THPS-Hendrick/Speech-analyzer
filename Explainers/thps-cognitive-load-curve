                <line x1="102" y1="45" x2="110" y2="45" stroke="#94a3b8" stroke-width="2"/>
                <text x="96" y="50" fill="#94a3b8" font-size="10" font-weight="700" text-anchor="end" font-family="'JetBrains Mono', monospace">100%</text>

                <line x1="102" y1="272" x2="110" y2="272" stroke="#94a3b8" stroke-width="2"/>
                <text x="96" y="276" fill="#94a3b8" font-size="10" font-weight="700" text-anchor="end" font-family="'JetBrains Mono', monospace">50%</text>

                <line x1="102" y1="500" x2="110" y2="500" stroke="#94a3b8" stroke-width="2"/>
                <text x="96" y="504" fill="#94a3b8" font-size="10" font-weight="700" text-anchor="end" font-family="'JetBrains Mono', monospace">0%</text>
              </g>

              <!-- X-AXIS -->
