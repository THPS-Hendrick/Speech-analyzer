  </main>

  <!-- Simulation Logic & Event Handling -->
  <script>
    const SKILLS_DATA = [
      { id: 'theory', name: '1. Theory', color: '#ef4444', textLight: true },
      { id: 'personal', name: '2. Personal', color: '#f97316', textLight: true },
      { id: 'visual', name: '3. Visual', color: '#f59e0b', textLight: false },
      { id: 'pause_var', name: '4. Pause Var', color: '#10b981', textLight: true },
      { id: 'vol_var', name: '5. Vol Var', color: '#06b6d4', textLight: true },
      { id: 'pace_var', name: '6. Pace Var', color: '#3b82f6', textLight: true },
      { id: 'aware', name: '7. Aware', color: '#6366f1', textLight: true },
      { id: 'runtime', name: '8. Runtime', color: '#8b5cf6', textLight: true },
      { id: 'question', name: '9. Question', color: '#d946ef', textLight: true },
      { id: 'repeat', name: '10. Repeat', color: '#ec4899', textLight: true },
      { id: 'count', name: '11. Count', color: '#14b8a6', textLight: true },
      { id: 'w_assoc', name: '12. W.Assoc', color: '#84cc16', textLight: false }
    ];

    const state = {
      selectedSkillIds: new Set(['theory']),
      activeMountedSkills: new Map(),
      isDraggingId: null,
      spawnNormX: 0.08
    };

    const SVG_CONFIG = {
      viewWidth: 1000,
      viewHeight: 562.5,
      xMin: 110,   // x = 0 (Left Axis)
      xMax: 960,   // x = 1 (Right Axis limit)
      yMin: 45,    // 100% Load tick
      yMax: 500    // 0% Load line
    };

    // REVERSE S-CURVE (Logistic Sigmoid Decay):
    // x = 0.00 -> 110.0%
    // x = 0.20 -> 98.8% (~99%)
    // x = 0.36 -> 55.0% (Inflection point / severe descent)
    // x = 0.67 -> 8.3% (~8%)
    // x = 1.00 -> 3.1% (~3%)
    // x -> infinity -> 0%
    function calculateCurve(normX) {
      const clampedX = Math.max(0, Math.min(1.0, normX));

      const L = 110;        // Initial plateau height at x = 0
      const x0 = 0.36;      // Inflection midpoint of steep descent
      const n = 3.6;        // Exponent controlling steepness
      
      const rawLoad = L / (1 + Math.pow(clampedX / x0, n));
      const loadPct = Math.round(rawLoad * 10) / 10;

      // Coordinate mapping: 100% load = yMin (45), 0% load = yMax (500)
      const normHeightRatio = loadPct / 100;
      const svgY = SVG_CONFIG.yMax - normHeightRatio * (SVG_CONFIG.yMax - SVG_CONFIG.yMin);
      const svgX = SVG_CONFIG.xMin + clampedX * (SVG_CONFIG.xMax - SVG_CONFIG.xMin);

      return { svgX, svgY, loadPct };
    }

    function svgXToNorm(svgX) {
      const clamped = Math.max(SVG_CONFIG.xMin, Math.min(SVG_CONFIG.xMax, svgX));
      return (clamped - SVG_CONFIG.xMin) / (SVG_CONFIG.xMax - SVG_CONFIG.xMin);
    }

    // Render Reverse S-Curve SVG Path
    function drawCurvePath() {
      const points = [];
      const steps = 150;
      for (let i = 0; i <= steps; i++) {
        const t = i / steps;
        const pt = calculateCurve(t);
        points.push(`${pt.svgX.toFixed(1)},${pt.svgY.toFixed(1)}`);
      }
      document.getElementById('curve-path').setAttribute('d', `M ${points.join(' L ')}`);
    }

    function getTotalCognitiveLoad() {
      let sum = 0;
      state.activeMountedSkills.forEach(skill => {
        sum += skill.loadPct;
      });
      return sum;
    }

    function renderSkillsBank() {
      const container = document.getElementById('skills-bank');
      container.innerHTML = '';

      SKILLS_DATA.forEach(skill => {
        const isSelected = state.selectedSkillIds.has(skill.id);
        const isMounted = state.activeMountedSkills.has(skill.id);

        const pillBtn = document.createElement('button');
        pillBtn.type = 'button';
        pillBtn.className = `p-2 rounded-xl text-xs font-semibold flex items-center justify-between border transition-all duration-200 ${
          isSelected 
            ? 'ring-2 ring-offset-2 ring-offset-slate-900 border-transparent shadow-md' 
            : 'bg-slate-900/90 border-slate-800 text-slate-400 hover:border-slate-600'
        }`;
        
        if (isSelected) {
          pillBtn.style.backgroundColor = `${skill.color}25`;
          pillBtn.style.borderColor = skill.color;
          pillBtn.style.color = skill.color;
          pillBtn.style.setProperty('--tw-ring-color', skill.color);
        }

        pillBtn.onclick = () => toggleSkillSelect(skill.id);

        pillBtn.innerHTML = `
          <div class="flex items-center space-x-2 truncate">
            <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background-color: ${skill.color}"></span>
            <span class="truncate">${skill.name}</span>
          </div>
          <span class="text-[10px] ml-1 shrink-0 ${isMounted ? 'text-emerald-400 font-mono font-bold' : 'text-slate-600'}">
            ${isMounted ? '● LIVE' : '○'}
          </span>
        `;

        container.appendChild(pillBtn);
      });

      document.getElementById('selected-counter').textContent = `(${state.selectedSkillIds.size} selected)`;
    }

    function toggleSkillSelect(id) {
      if (state.selectedSkillIds.has(id)) {
        state.selectedSkillIds.delete(id);
      } else {
        state.selectedSkillIds.add(id);
      }
      renderSkillsBank();
    }

    function toggleAllSkills(selectAll) {
      if (selectAll) {
        SKILLS_DATA.forEach(s => state.selectedSkillIds.add(s.id));
      } else {
        state.selectedSkillIds.clear();
      }
      renderSkillsBank();
    }

    function combinePills() {
      for (const [id] of state.activeMountedSkills.entries()) {
        if (!state.selectedSkillIds.has(id)) {
          state.activeMountedSkills.delete(id);
        }
      }

      let stagger = 0;
      state.selectedSkillIds.forEach(id => {
        if (!state.activeMountedSkills.has(id)) {
          const meta = SKILLS_DATA.find(s => s.id === id);
          const normX = Math.min(0.92, state.spawnNormX + (stagger * 0.05));
          const curveData = calculateCurve(normX);
          state.activeMountedSkills.set(id, {
            data: meta,
            normX: normX,
            loadPct: curveData.loadPct
          });
          stagger++;
        }
      });

      updateAllVisuals();
      renderSkillsBank();

      const btn = document.getElementById('btn-combine');
      btn.classList.add('scale-95');
      setTimeout(() => btn.classList.remove('scale-95'), 120);
    }

    function updateAllVisuals() {
      updateGraphNodes();
      updateCapacityTube();
      updateCaliberBanner();
    }

    function updateGraphNodes() {
      const layer = document.getElementById('curve-nodes-layer');
      layer.innerHTML = '';

      state.activeMountedSkills.forEach((skillState, id) => {
        const { svgX, svgY } = calculateCurve(skillState.normX);
        const meta = skillState.data;

        const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
        g.setAttribute('class', 'draggable-pill');
        g.setAttribute('data-skill-id', id);
        g.setAttribute('transform', `translate(${svgX}, ${svgY})`);

        g.innerHTML = `
          <line x1="0" y1="0" x2="0" y2="${SVG_CONFIG.yMax - svgY}" stroke="${meta.color}" stroke-opacity="0.4" stroke-dasharray="3 3" stroke-width="1.8" />
          <circle cx="0" cy="0" r="17" fill="${meta.color}" fill-opacity="0.25" />
          <rect x="-44" y="-15" width="88" height="30" rx="15" fill="#090d16" stroke="${meta.color}" stroke-width="2.5" />
          <circle cx="-27" cy="0" r="5" fill="${meta.color}" />
          <text x="-16" y="4.5" fill="#ffffff" font-size="11" font-weight="700" font-family="'Inter', sans-serif">
            ${meta.name.replace(/^[0-9]+\.\s*/, '')}
          </text>
        `;

        g.addEventListener('mousedown', (e) => startDrag(e, id));
        g.addEventListener('touchstart', (e) => startDrag(e, id), { passive: false });

        layer.appendChild(g);
      });
    }

    function updateCapacityTube() {
      const container = document.getElementById('tube-segments-wrapper');
      const emptyHint = document.getElementById('empty-tube-hint');
      const tubeHousing = document.getElementById('tube-container');
      const loadReadout = document.getElementById('load-readout');
      const redZoneOverlay = document.getElementById('red-zone-failsafe-overlay');

      container.innerHTML = '';

      if (state.activeMountedSkills.size === 0) {
        emptyHint.classList.remove('hidden');
        redZoneOverlay.classList.add('hidden');
        tubeHousing.classList.remove('tube-overload');
        loadReadout.textContent = '0% / 100%';
        loadReadout.className = 'mono text-xs sm:text-sm font-bold text-slate-400';
        return;
      }

      emptyHint.classList.add('hidden');

      const totalLoadPct = getTotalCognitiveLoad();
      const roundedTotal = Math.round(totalLoadPct);
      loadReadout.textContent = `${roundedTotal}% / 100%`;

      if (roundedTotal >= 110) {
        redZoneOverlay.classList.remove('hidden');
        tubeHousing.classList.add('tube-overload');
        loadReadout.className = 'mono text-xs sm:text-sm font-black text-red-400 animate-pulse';
        return;
      }

      redZoneOverlay.classList.add('hidden');

      state.activeMountedSkills.forEach((skillState) => {
        const meta = skillState.data;
        const load = skillState.loadPct;
        const visualHeightPct = (load / 110) * 100;

        const segment = document.createElement('div');
        segment.className = 'w-full tube-segment flex items-center justify-between px-1.5 font-bold shadow-sm shrink-0 overflow-hidden rounded-sm';
        segment.style.backgroundColor = meta.color;
        segment.style.height = `${Math.max(1.8, visualHeightPct)}%`;
        segment.style.color = meta.textLight ? '#ffffff' : '#070a12';

        segment.innerHTML = `
          <span class="truncate text-[8.5px] leading-tight">${meta.name.replace(/^[0-9]+\.\s*/, '')}</span>
          <span class="mono text-[8px] opacity-90 ml-1 shrink-0">${Math.round(load)}%</span>
        `;

        container.appendChild(segment);
      });

      if (roundedTotal > 100) {
        tubeHousing.classList.add('tube-overload');
        loadReadout.className = 'mono text-xs sm:text-sm font-black text-amber-400 animate-pulse';
      } else if (roundedTotal > 75) {
        tubeHousing.classList.remove('tube-overload');
        loadReadout.className = 'mono text-xs sm:text-sm font-bold text-amber-400';
      } else {
        tubeHousing.classList.remove('tube-overload');
        loadReadout.className = 'mono text-xs sm:text-sm font-bold text-emerald-400';
      }
    }

    function updateCaliberBanner() {
      const bannerInner = document.getElementById('caliber-banner-inner');
      const bannerIcon = document.getElementById('caliber-banner-icon');
      const bannerTitle = document.getElementById('caliber-banner-title');
      const bannerText = document.getElementById('caliber-banner-text');
      const bannerBadge = document.getElementById('caliber-banner-badge');

      const count = state.activeMountedSkills.size;
      const totalLoad = getTotalCognitiveLoad();

      if (totalLoad >= 110) {
        bannerInner.className = 'bg-red-950/80 border-2 border-red-500 text-red-100 px-4 py-3 rounded-xl flex items-center justify-between gap-3 text-xs sm:text-sm shadow-xl backdrop-blur-md animate-pulse';
        bannerIcon.className = 'p-1.5 rounded-lg bg-red-500/30 text-red-300 shrink-0';
        bannerIcon.innerHTML = `<i data-lucide="flame" class="w-5 h-5 text-red-400"></i>`;
        bannerTitle.textContent = 'Cognitive Overload:';
        bannerTitle.className = 'font-black text-white uppercase tracking-wide block sm:inline';
        bannerText.textContent = 'You need to practice to use this many speaking skills under pressure.';
        bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-black rounded-md bg-red-600 text-white mono shadow-lg border border-red-400';
        bannerBadge.textContent = 'RED ZONE';
      } else {
        bannerInner.className = 'bg-slate-900/90 border border-slate-700/80 text-slate-200 px-4 py-3 rounded-xl flex items-center justify-between gap-3 text-xs sm:text-sm shadow-md backdrop-blur-md';
        bannerIcon.className = 'p-1.5 rounded-lg bg-blue-500/20 text-blue-400 shrink-0';
        bannerIcon.innerHTML = `<i data-lucide="award" class="w-5 h-5"></i>`;
        bannerTitle.textContent = 'Speaker Caliber:';
        bannerTitle.className = 'font-bold text-white uppercase tracking-wide block sm:inline';

        if (count === 0) {
          bannerText.textContent = 'Select speaking skills from the bank below and click Combine to deploy.';
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-bold rounded-md bg-slate-800 text-slate-400 border border-slate-700 mono';
          bannerBadge.textContent = '0 SKILLS';
        } else if (count <= 2) {
          bannerText.textContent = `${count} skill${count > 1 ? 's' : ''} means in a room of 100 people you're the 98th best speaker (Top 98%).`;
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-extrabold rounded-md bg-stone-500/20 text-stone-300 border border-stone-500/40 mono';
          bannerBadge.textContent = 'TOP 98%';
        } else if (count <= 4) {
          bannerText.textContent = `${count} skills means in a room of 100 people you're the 80th best speaker (Top 80%).`;
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-extrabold rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/40 mono';
          bannerBadge.textContent = 'TOP 80%';
        } else if (count <= 6) {
          bannerText.textContent = `${count} skills means in a room of 100 people you're the 30th best speaker (Top 30%).`;
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-extrabold rounded-md bg-sky-500/20 text-sky-300 border border-sky-500/40 mono';
          bannerBadge.textContent = 'TOP 30%';
        } else if (count <= 8) {
          bannerText.textContent = `${count} skills means in a room of 100 people you're the 7th best speaker (Top 7%).`;
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-extrabold rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 mono';
          bannerBadge.textContent = 'TOP 7%';
        } else if (count <= 10) {
          bannerText.textContent = `${count} skills means in a room of 1,000 people you're the 5th best speaker (Top 0.5%).`;
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-extrabold rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 mono';
          bannerBadge.textContent = 'TOP 0.5%';
        } else {
          bannerText.textContent = `${count} skills means in a room of 1,000 people you're the #1 best speaker (Top 0.02%).`;
          bannerBadge.className = 'shrink-0 px-2.5 py-1 text-[11px] font-black rounded-md bg-emerald-500 text-slate-950 border border-emerald-400 mono shadow-lg';
          bannerBadge.textContent = 'TOP 0.02%';
        }
      }

      lucide.createIcons();
    }

    const svgEl = document.getElementById('graph-svg');
    const tooltip = document.getElementById('node-drag-tooltip');

    function getSvgCoordinates(e) {
      const rect = svgEl.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      
      const x = ((clientX - rect.left) / rect.width) * SVG_CONFIG.viewWidth;
      const y = ((clientY - rect.top) / rect.height) * SVG_CONFIG.viewHeight;
      return { x, y, clientX, clientY };
    }

    function startDrag(e, skillId) {
      e.preventDefault();
      state.isDraggingId = skillId;

      const skillNode = state.activeMountedSkills.get(skillId);
      if (!skillNode) return;

      const coords = getSvgCoordinates(e);
      showTooltip(coords.clientX, coords.clientY, skillNode);

      window.addEventListener('mousemove', handleDragMove);
      window.addEventListener('touchmove', handleDragMove, { passive: false });
      window.addEventListener('mouseup', stopDrag);
      window.addEventListener('touchend', stopDrag);
    }

    function handleDragMove(e) {
      if (!state.isDraggingId) return;
      e.preventDefault();

      const skillNode = state.activeMountedSkills.get(state.isDraggingId);
      if (!skillNode) return;

      const coords = getSvgCoordinates(e);
      const targetNormX = svgXToNorm(coords.x);

      const curveData = calculateCurve(targetNormX);
      skillNode.normX = targetNormX;
      skillNode.loadPct = curveData.loadPct;

      updateAllVisuals();
      showTooltip(coords.clientX, coords.clientY, skillNode);
    }

    function stopDrag() {
      state.isDraggingId = null;
      hideTooltip();
      window.removeEventListener('mousemove', handleDragMove);
      window.removeEventListener('touchmove', handleDragMove);
      window.removeEventListener('mouseup', stopDrag);
      window.removeEventListener('touchend', stopDrag);
    }

    function showTooltip(clientX, clientY, skillNode) {
      const stageName = skillNode.normX < 0.28 
        ? 'Cognitive' 
        : (skillNode.normX < 0.67 ? 'Associative' : 'Autonomous');

      tooltip.innerHTML = `<strong>${skillNode.data.name}</strong> • ${stageName} • <span class="text-amber-300 font-bold">${Math.round(skillNode.loadPct)}% Load</span>`;
      tooltip.style.left = `${clientX}px`;
      tooltip.style.top = `${clientY}px`;
      tooltip.style.opacity = '1';
    }

    function hideTooltip() {
      tooltip.style.opacity = '0';
    }

    function applyPreset(presetType) {
      state.selectedSkillIds.clear();
      state.activeMountedSkills.clear();

      if (presetType === 'novice') {
        // Two skills near the top plateau (>99% each -> triggers Red Zone)
        const skills = ['theory', 'personal'];
        skills.forEach((id, idx) => {
          state.selectedSkillIds.add(id);
          const normX = 0.05 + (idx * 0.08);
          const meta = SKILLS_DATA.find(s => s.id === id);
          const curveData = calculateCurve(normX);
          state.activeMountedSkills.set(id, {
            data: meta,
            normX,
            loadPct: curveData.loadPct
          });
        });
      } else if (presetType === 'intermediate') {
        // Skills located on the steep downward slope
        const skills = ['theory', 'personal', 'visual', 'pause_var'];
        skills.forEach((id, idx) => {
          state.selectedSkillIds.add(id);
          const normX = 0.46 + (idx * 0.06);
          const meta = SKILLS_DATA.find(s => s.id === id);
          const curveData = calculateCurve(normX);
          state.activeMountedSkills.set(id, {
            data: meta,
            normX,
            loadPct: curveData.loadPct
          });
        });
      } else if (presetType === 'master') {
        // All 12 skills drilled into Effortless/Autonomous range (~3% to 8%)
        SKILLS_DATA.forEach((meta, idx) => {
          state.selectedSkillIds.add(meta.id);
          const normX = 0.68 + (idx * 0.025);
          const curveData = calculateCurve(normX);
          state.activeMountedSkills.set(meta.id, {
            data: meta,
            normX,
            loadPct: curveData.loadPct
          });
        });
      }

      renderSkillsBank();
      updateAllVisuals();
    }

    window.onload = function() {
      lucide.createIcons();
      drawCurvePath();
      renderSkillsBank();
      combinePills();
    };
  </script>
</body>
